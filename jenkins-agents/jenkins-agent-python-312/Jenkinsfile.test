pipeline {
    agent {
      label 'jenkins-agent-python-312'
    }

    stages {
        stage ('Run Test') {
            steps {
              sh '''
                  python3 -V
                  pip -V
                  java -version
                  rm -rf /tmp/v
                  python3 -m venv /tmp/v && /tmp/v/bin/pip install flake8==7.5.0 && /tmp/v/bin/flake8 --version
              '''
            }
        }
    }
}
